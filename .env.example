# Copy this file to .env and fill in real provider credentials.
# The placeholder values only allow Spring Boot to start; they cannot call a model.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-with-your-llm-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=replace-with-your-embedding-key
